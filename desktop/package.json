{
  "name": "omopredict-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "description": "OMOPredict 桌面壳（Electron）：Host 层拉起并守护 Go 中间层与引擎（docs/desktop.md T6/T7）",
  "main": "dist/main/main.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "//clean": "esbuild 不会清理输出目录，改名/删掉的旧产物会残留在 dist 里（曾残留两个 CJS 模块）",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:main": "tsc -p tsconfig.build.json",
    "//build:preload": "必须打成单文件：沙箱化的 preload 不支持相对 require（实测 module not found: ./shell/preloadBridge）",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.js",
    "build": "pnpm clean && pnpm build:main && pnpm build:preload",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "typescript": "~5.8.3",
    "vitest": "^5.0.2"
  },
  "//build": "electron-builder 配置（docs/desktop.md D4/D9）。真正的打包脚本 build-desktop.ps1 / build-lite.ps1 与体积门禁属 T8/T9；此处先固化布局契约：壳资源里放渲染产物 dist/ 与随包引擎 engine/，后端可执行文件放资源根。",
  "build": {
    "appId": "com.omopredict.desktop",
    "productName": "OMOPredict",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "dist"
      },
      {
        "from": "release-bin/omopredict-server.exe",
        "to": "omopredict-server.exe"
      },
      {
        "from": "release-bin/omo-rpc",
        "to": "engine"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
