# 复制为 .env 后按需修改（.env 已被 gitignore，不入库）
#
# 数据库驱动：sqlite | mysql | postgres
OMO_DB_DRIVER=sqlite

# 连接串（DSN）示例：
#   sqlite:   omopredict.db            （文件路径）
#   mysql:    user:pass@tcp(127.0.0.1:3306)/omopredict?charset=utf8mb4&parseTime=True&loc=Local
#   postgres: host=127.0.0.1 user=postgres password=pass dbname=omopredict port=5432 sslmode=disable
OMO_DB_DSN=omopredict.db

# JWT 签名密钥（生产必须设置）
# OMO_JWT_SECRET=change-me
# 令牌有效期（Go duration，默认 24h）
# OMO_JWT_TTL=24h
# 监听地址（默认 :8080）
# OMO_SERVER_ADDR=:8080

# Python 引擎地址（任务编排调用 /simulate；配合 uvicorn 启动）
# OMO_ENGINE_URL=http://127.0.0.1:8000
